# PostgreSQL Client Authentication Configuration File
# Managed by Ansible - PostgreSQL Access Role

# Local connections
local   all             postgres                                peer
local   all             all                                     peer

# Local TCP/IP connections
host    all             all             127.0.0.1/32            scram-sha-256
host    all             all             ::1/128                 scram-sha-256

# Cluster node access - eth0 addresses
{% for client_ip in postgresql_access_client_ips %}
host    all             all             {{ client_ip }}         {{ postgresql_access_auth_method }}
{% endfor %}
